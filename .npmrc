# pnpm monorepo hoisting
# Metro's Babel transform worker runs in an isolated subprocess and resolves
# @babel/plugin-* packages starting from the root node_modules.
# pnpm's virtual store isolation makes them invisible without hoisting.
#
# shamefully-hoist=true hoists all packages to root node_modules (like npm/yarn),
# which is the standard requirement for React Native + Metro in pnpm monorepos.
shamefully-hoist=true
