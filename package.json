{
  "name": "cluanote-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "desktop": "pnpm --filter @cluanote/desktop",
    "tauri": "pnpm --filter @cluanote/desktop tauri"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "turbo": "^2"
  }
}
